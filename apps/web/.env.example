# Postgres (docker-compose defaults)
DATABASE_URL=postgres://marketos:marketos@localhost:5432/marketos

# Redis for BullMQ (docker-compose defaults)
REDIS_URL=redis://localhost:6379

# Gemini API key — https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Telegram notifications (Phase 2)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Basic auth for the dashboard (Phase 3)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Set to 'false' to disable cron/workers (e.g. during local UI work)
ENABLE_JOBS=true
